# Copy to .env (never commit .env).
GEMINI_API_KEY=                       # free key: https://aistudio.google.com/apikey  (empty = free local engine)
NOVA_ENGINE=auto                      # auto | gemini | local
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.6-flash   # used by the eval runner's LLM judge
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
NOVA_EMBEDDINGS=1                     # 0 = lexical retrieval only (saves embedding requests)
PRICE_INPUT_PER_MTOK=0.30             # USD per 1M tokens, for cost estimates (paid-tier price)
PRICE_OUTPUT_PER_MTOK=2.50
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=3
MAX_TOOL_ROUNDS=4
HISTORY_TURNS=6                       # turns kept verbatim; older ones are summarised
SESSION_TTL_SECONDS=3600
ANSWER_CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MIN=30
ALLOWED_ORIGINS=*                     # e.g. https://your-shop.com
LOG_DIR=logs
